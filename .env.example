APP_NAME=Mark's Business Studio
APP_ENV=production
APP_URL=https://booking.weddingsbymark.uk
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=mark@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql+psycopg://bookingapp:replace-db-password@database:5432/bookingapp
POSTGRES_DB=bookingapp
POSTGRES_USER=bookingapp
POSTGRES_PASSWORD=replace-db-password
STORAGE_ROOT=/app/storage
COOKIE_SECURE=true
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
# Keep this restricted unless the exact Nginx Proxy Manager address/subnet is known.
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_UPLOAD_MB=25
INVOICE_START=2000
SEED_DEMO_DATA=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_WBM_USERNAME=mark@perfectweddingsbymark.uk
SMTP_WBM_PASSWORD=replace-with-weddings-by-mark-email-password
SMTP_IVORY_USERNAME=admin@ivorydigital.uk
SMTP_IVORY_PASSWORD=replace-with-ivory-digital-email-password
SMTP_USE_SSL=true
REMINDERS_ENABLED=false
REMINDER_SCAN_HOURS=6
EMAIL_RETRY_MINUTES=60
GOOGLE_MAPS_API_KEY=replace-with-your-restricted-google-maps-key
# Google Calendar uses a separate OAuth Web application in Google Cloud.
# Authorized redirect URI: https://booking.weddingsbymark.uk/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://booking.weddingsbymark.uk/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_RETRY_MINUTES=30
ACCOUNTS_INTEGRATION_ENABLED=false
ACCOUNTS_INTEGRATION_AUTO_SYNC=false
ACCOUNTS_API_URL=http://192.168.24.10:30053
ACCOUNTS_INTEGRATION_KEY=replace-with-the-same-64-character-secret-used-by-accounts
ACCOUNTS_SYNC_MINUTES=10
